[Unit]
Description=vazy : configuration de l'invite depuis guestinfo (nom d'hote, identite SSH)
Documentation=https://github.com/spp4tme/VAZY
DefaultDependencies=no
ConditionVirtualization=vmware
After=local-fs.target
Before=network-pre.target sysinit.target shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/vazy-guestinfo
# KillMode=process : en mode reserve chaude, le script laisse derriere lui une
# attente en tache de fond, qui sera figee avec la machine puis reprise au
# reveil pour appliquer la nouvelle identite. Avec le mode par defaut
# (control-group), systemd la tuerait des la fin du script principal.
KillMode=process

[Install]
WantedBy=sysinit.target
