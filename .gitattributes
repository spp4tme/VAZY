# Fins de ligne : normalisées en LF dans le dépôt, CRLF à l'extraction pour
# les scripts Windows (vazy.cmd doit rester en CRLF ; les .ps1 gardent leur BOM).
* text=auto
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.md text
*.json text
# Fichiers destinés à un invité Linux : toujours en LF
*.sh text eol=lf
*.service text eol=lf
